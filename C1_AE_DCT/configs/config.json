{
  "project": {
    "name": "C1_AE_DCT",
    "version": "1.0.0",
    "description": "Autoencoder & Discrete Cosine Transform (DCT) Baseline for Signal/Image Processing & IoT"
  },
  "data": {
    "raw_dir": "data/raw",
    "processed_dir": "data/processed",
    "batch_size": 128,
    "num_workers": 0,
    "fs": 64,
    "input_channels": 4,
    "window_samples": 512
  },
  "model": {
    "name": "c1_ae_dct_model",
    "input_channels": 4,
    "window_samples": 512,
    "d_b_list": [16, 8, 4, 2],
    "use_dct_baseline": true
  },
  "training": {
    "max_epoch": 100,
    "epochs": 100,
    "learning_rate": 0.001,
    "lr": 0.001,
    "weight_decay": 0.0,
    "early_stopping_patience": 10,
    "patience": 10,
    "device": "cuda",
    "seed": 42
  },
  "paths": {
    "checkpoints_dir": "checkpoints",
    "logs_dir": "logs",
    "results_dir": "results"
  }
}

